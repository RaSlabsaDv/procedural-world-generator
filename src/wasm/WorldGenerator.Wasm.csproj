<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../core/WorldGenerator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../hosts/GenerationResponse.cs" Link="GenerationResponse.cs" />
    <Compile Include="../hosts/ErrorResponse.cs" Link="ErrorResponse.cs" />
    <Compile Include="../hosts/HeightMapWireRequest.cs" Link="HeightMapWireRequest.cs" />
    <Compile Include="../hosts/HeightMapTransport.cs" Link="HeightMapTransport.cs" />
    <Compile Include="../hosts/HostJson.cs" Link="HostJson.cs" />
    <Compile Include="../hosts/CoreBuildId.cs" Link="CoreBuildId.cs" />
  </ItemGroup>

  <Import Project="../hosts/HostBuildIdentity.targets" />
</Project>
